<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Plugin specific properties -->
  <PropertyGroup>
    <Product>Satora</Product>
    <Description>Allows your customers to pay in Stablecoins with Satora in a seamless and non custodial way. Please read our documentation for updates history</Description>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <!-- Plugin development properties -->
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <OutputType>Library</OutputType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SatoraSdkRoot>$(MSBuildProjectDirectory)/../../lendaswap-sdk</SatoraSdkRoot>
    <SatoraSdkNativeTargetDir>$(MSBuildProjectDirectory)/obj/satora-sdk-native</SatoraSdkNativeTargetDir>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <SatoraSdkNativeFileName>libsatora_sdk_ffi.dylib</SatoraSdkNativeFileName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <SatoraSdkNativeFileName>libsatora_sdk_ffi.so</SatoraSdkNativeFileName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <SatoraSdkNativeFileName>satora_sdk_ffi.dll</SatoraSdkNativeFileName>
  </PropertyGroup>

  <ItemGroup Condition="$(Configuration) != 'Release'">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\btcpayserver\BTCPayServer\BTCPayServer.csproj"
                      Private="false"
                      ExcludeAssets="runtime;native;build;buildTransitive;contentFiles">
      <Properties>StaticWebAssetsEnabled=false</Properties>
    </ProjectReference>
    <ProjectReference Include="..\..\lendaswap-sdk\dotnet-sdk\Satora.Sdk\Satora.Sdk.csproj"
                      Private="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\**" />
    <SatoraSdkNativeSources Include="$(SatoraSdkRoot)/dotnet-sdk/native/Cargo.toml" />
    <SatoraSdkNativeSources Include="$(SatoraSdkRoot)/dotnet-sdk/native/Cargo.lock" />
    <SatoraSdkNativeSources Include="$(SatoraSdkRoot)/dotnet-sdk/native/src/**/*.rs" />
  </ItemGroup>

  <Target Name="BuildLocalSatoraSdkNative"
          BeforeTargets="ResolveReferences"
          Condition="'$(SkipSatoraSdkNativeBuild)' != 'true'"
          Inputs="@(SatoraSdkNativeSources)"
          Outputs="$(SatoraSdkNativeTargetDir)/release/$(SatoraSdkNativeFileName)">
    <Error Condition="'$(SatoraSdkNativeFileName)' == ''"
           Text="Unsupported OS for building the local Satora SDK native library." />
    <Exec Command="cargo build --manifest-path &quot;$(SatoraSdkRoot)/dotnet-sdk/native/Cargo.toml&quot; --release --target-dir &quot;$(SatoraSdkNativeTargetDir)&quot;" />
  </Target>

  <Target Name="CopyLocalSatoraSdkNative"
          AfterTargets="Build"
          Condition="'$(SkipSatoraSdkNativeBuild)' != 'true'">
    <Error Condition="!Exists('$(SatoraSdkNativeTargetDir)/release/$(SatoraSdkNativeFileName)')"
           Text="The local Satora SDK native library was not found at $(SatoraSdkNativeTargetDir)/release/$(SatoraSdkNativeFileName)." />
    <Copy SourceFiles="$(SatoraSdkNativeTargetDir)/release/$(SatoraSdkNativeFileName)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
