<br />

<partial name="_StatusMessage" />
<br />

<div permission="@Policies.CanModifyStoreSettings">
    <h4>Wallet</h4>
    @if (Model.NetworkError is not null)
    {
        <div class="alert alert-danger">@Model.NetworkError</div>
    }
    else
    {
        var state = Model.WalletState;
        var hasSeed = state is SatoraWalletState.BackupRequired or SatoraWalletState.Ready;
        async Task RestoreForm(bool replace)
        {
            <form method="post" asp-action="RestoreWallet" asp-route-storeId="@Model.StoreId" class="mb-4">
                <div class="form-group">
                    <label for="Seed@(replace)" class="form-label">Recovery phrase</label>
                    <textarea id="Seed@(replace)" name="Seed" class="form-control font-monospace" rows="2" autocomplete="off" spellcheck="false"></textarea>
                </div>
                <div class="form-group">
                    <label for="SeedConfirmation@(replace)" class="form-label">Recovery phrase again</label>
                    <textarea id="SeedConfirmation@(replace)" name="SeedConfirmation" class="form-control font-monospace" rows="2" autocomplete="off" spellcheck="false"></textarea>
                </div>
                @if (replace)
                {
                    <div class="form-group">
                        <label for="RestoreReplaceConfirmation" class="form-label">Type @SeedWriteGuard.ConfirmationWord if the current wallet holds funds</label>
                        <input id="RestoreReplaceConfirmation" name="ReplaceConfirmation" class="form-control" autocomplete="off" />
                    </div>
                }
                <button type="submit" class="btn btn-secondary">Restore</button>
            </form>
        }

        <p>
            <span class="text-secondary">Status:</span>
            <strong>@(state switch
            {
                SatoraWalletState.NotSetUp => "Not set up",
                SatoraWalletState.RestoreRequired => "Restore required",
                SatoraWalletState.Locked => "Locked",
                SatoraWalletState.BackupRequired => "Backup not confirmed",
                _ => Model.Enabled ? "Enabled" : "Disabled"
            })</strong>
        </p>
        @if (state == SatoraWalletState.RestoreRequired)
        {
            <div class="alert alert-warning">This Satora wallet's seed was saved by an earlier plugin version, which this version cannot read. Restore the wallet from its recovery phrase to use it.</div>
        }
        @if (state == SatoraWalletState.Locked)
        {
            <div class="alert alert-danger">The wallet seed can no longer be decrypted, most likely because BTCPay's data protection keys changed. Restore this wallet's recovery phrase to unlock it. No other wallet can be set up until then.</div>
        }

        @if (!Model.CanUseHotWallet)
        {
            <div class="alert alert-info">The Satora wallet is a hot wallet. Ask a server admin to set it up, show its recovery phrase or enable it.</div>
            @if (Model.Enabled)
            {
                <form method="post" asp-action="Index" asp-route-storeId="@Model.StoreId">
                    <button type="submit" class="btn btn-outline-danger">Disable</button>
                </form>
            }
        }
        else
        {
            @if (state == SatoraWalletState.NotSetUp)
            {
                <form method="post" asp-action="GenerateWallet" asp-route-storeId="@Model.StoreId" class="mb-4">
                    <button type="submit" class="btn btn-primary">Generate a new wallet</button>
                </form>
            }
            @if (state is SatoraWalletState.NotSetUp or SatoraWalletState.RestoreRequired or SatoraWalletState.Locked)
            {
                <h5>Restore a wallet</h5>
                await RestoreForm(false);
            }
            @if (state == SatoraWalletState.BackupRequired)
            {
                <div class="alert alert-warning">Enter the recovery phrase to confirm it is backed up. The wallet can be enabled after that.</div>
                <form method="post" asp-action="ConfirmBackup" asp-route-storeId="@Model.StoreId" class="mb-4">
                    <div class="form-group">
                        <label for="SeedConfirmation" class="form-label">Recovery phrase</label>
                        <textarea id="SeedConfirmation" name="SeedConfirmation" class="form-control font-monospace" rows="2" autocomplete="off" spellcheck="false"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Confirm backup</button>
                </form>
            }
            @if (state == SatoraWalletState.Ready)
            {
                <form method="post" asp-action="Index" asp-route-storeId="@Model.StoreId" class="mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <input id="Enabled" name="Enabled" value="true" type="checkbox" class="btcpay-toggle" checked="@Model.Enabled" />
                        <label for="Enabled" class="form-check-label">Enabled</label>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                    <div class="form-text">Enabling makes the wallet the store's Lightning node and turns LNURL off, unless the store already uses another Lightning node. BTCPay then pays its Lightning payouts and refunds from this wallet. API keys allowed to use the store's Lightning node can also pay invoices from it. Checkout also offers "Bitcoin (Satora)" beside the store's own on-chain wallet. On mainnet, Lightning is offered only on invoices that expire within 20 minutes.</div>
                </form>
                <form method="post" asp-action="RotateLightningKey" asp-route-storeId="@Model.StoreId" class="mb-4">
                    <button type="submit" class="btn btn-outline-secondary">Rotate Lightning connection key</button>
                    <div class="form-text">Anyone with the store's Satora Lightning connection string can use this wallet as a Lightning node. Rotate the key if the string may have leaked. Old copies then stop working. If the store uses this wallet for Lightning, its settings get the new key.</div>
                </form>
                @if (Model.Enabled)
                {
                    <details class="mb-4">
                        <summary>Use the Satora wallet as this store's Lightning node</summary>
                        <p class="mt-3">This replaces the store's current Lightning node with the Satora wallet. Lightning payments and payouts then go through the wallet instead. Lightning is turned on at checkout and LNURL is turned off. To switch back, set up the old node again in the store's Lightning settings.</p>
                        <form method="post" asp-action="UseAsLightningNode" asp-route-storeId="@Model.StoreId">
                            <div class="form-group">
                                <label for="LightningReplaceConfirmation" class="form-label">Type @SeedWriteGuard.ConfirmationWord to replace the store's Lightning node</label>
                                <input id="LightningReplaceConfirmation" name="ReplaceConfirmation" class="form-control" autocomplete="off" />
                            </div>
                            <button type="submit" class="btn btn-outline-danger">Use the Satora wallet as this store's Lightning node</button>
                        </form>
                    </details>
                }
            }
            @if (hasSeed)
            {
                <form method="post" asp-action="ViewSeed" asp-route-storeId="@Model.StoreId" class="mb-4">
                    <button type="submit" class="btn btn-outline-secondary">Show recovery phrase</button>
                </form>
                <details class="mb-4">
                    <summary>Replace the wallet</summary>
                    <p class="mt-3">Replacing is blocked while swaps, refunds or withdrawals of this wallet are open. Back up its recovery phrase first. It cannot be shown after replacing. The old seed stays on the server, encrypted, but is no longer used.</p>
                    <form method="post" asp-action="GenerateWallet" asp-route-storeId="@Model.StoreId" class="mb-4">
                        <div class="form-group">
                            <label for="GenerateReplaceConfirmation" class="form-label">Type @SeedWriteGuard.ConfirmationWord if the current wallet holds funds</label>
                            <input id="GenerateReplaceConfirmation" name="ReplaceConfirmation" class="form-control" autocomplete="off" />
                        </div>
                        <button type="submit" class="btn btn-outline-danger">Generate a new wallet</button>
                    </form>
                    <h5>Restore another wallet</h5>
                    @{ await RestoreForm(true); }
                </details>
            }
        }

        @if (hasSeed)
        {
            <partial name="_SatoraWalletBalance" model="Model.StoreId" />
            <a asp-controller="SatoraWithdraw" asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-primary mb-3">Withdraw</a>
            <a asp-controller="SatoraChainRefund" asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-outline-secondary mb-3">On-chain refunds</a>
            <partial name="_SatoraSpendingBoundary" model="Model.AutomatedLightningPayouts" />
        }
    }
</div>
