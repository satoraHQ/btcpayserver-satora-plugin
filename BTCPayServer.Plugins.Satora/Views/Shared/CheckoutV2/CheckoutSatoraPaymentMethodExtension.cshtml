@using BTCPayServer.Plugins.Satora.Services
@inject SatoraWalletService walletService
@{
    if (!(await walletService.GetStatusAsync(Model.StoreId)).Enabled) return;
}

<a href="#Satora" class="btcpay-pill m-0 payment-method" :class="{ active: pmId === 'Satora' }"
       v-on:click.prevent="changePaymentMethod('Satora')">
    <div style="text-align: center;">
        <span style="display: block;">Stablecoins</span>
    </div>
</a>
